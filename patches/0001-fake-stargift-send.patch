+    private static func genericGift(_ gifts: [StarGift], index: Int) -> StarGift.Gift? {
+        var byId: [Int64: StarGift.Gift] = [:]
+        var all: [StarGift.Gift] = []
+        for gift in gifts {
+            if case let .generic(item) = gift {
+                byId[item.id] = item
+                all.append(item)
+            }
+        }
+        let knownPresent = Self.numberedGiftIds.contains(where: { byId[$0] != nil })
+        if knownPresent {
+            if index >= 1 && index <= Self.numberedGiftIds.count {
+                return byId[Self.numberedGiftIds[index - 1]]
+            }
+            let extras = all.filter { !Self.numberedGiftIds.contains($0.id) }.sorted { $0.id < $1.id }
+            let extraIndex = index - Self.numberedGiftIds.count - 1
+            if extraIndex >= 0 && extraIndex < extras.count {
+                return extras[extraIndex]
+            }
+            return nil
+        }
+        guard index >= 1 && index <= all.count else {
+            return nil
+        }
+        return all[index - 1]
+    }
