+import Foundation
+import PhotosUI
+import UIKit
+import UniformTypeIdentifiers
+
+public enum GiftCamBears {
+    public static let bearGiftId: Int64 = 5170233102089322756
+
+    public struct Bear: Codable, Equatable {
+        public var id: String
+        public var name: String
+        public var file: String
+    }
+
+    private struct IndexFile: Codable {
+        var active: String?
+        var bears: [Bear]
+    }
+
+    public static func activeFileURL() -> URL? {
+        let index = self.load()
+        guard let active = index.active, let bear = index.bears.first(where: { $0.id == active }) else {
+            return nil
+        }
+        let url = self.directory().appendingPathComponent(bear.file)
+        return FileManager.default.fileExists(atPath: url.path) ? url : nil
+    }
+
+    public static func present() {
+        let scenes = UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }
+        let scene = scenes.first { $0.activationState == .foregroundActive } ?? scenes.first
+        var top = scene?.keyWindow?.rootViewController
+        while let presented = top?.presentedViewController {
+            top = presented
+        }
+        let controller = UINavigationController(rootViewController: GiftCamBearsController())
+        controller.modalPresentationStyle = .formSheet
+        top?.present(controller, animated: true)
+    }
+
+    static func load() -> (active: String?, bears: [Bear]) {
+        let url = self.directory().appendingPathComponent("index.json")
+        guard let data = try? Data(contentsOf: url), let index = try? JSONDecoder().decode(IndexFile.self, from: data) else {
+            return (nil, [])
+        }
+        return (index.active, index.bears)
+    }
+
+    static func save(active: String?, bears: [Bear]) {
+        let index = IndexFile(active: active, bears: bears)
+        guard let data = try? JSONEncoder().encode(index) else {
+            return
+        }
+        try? data.write(to: self.directory().appendingPathComponent("index.json"), options: .atomic)
+    }
+
+    static func directory() -> URL {
+        let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0].appendingPathComponent("giftcam-bears", isDirectory: true)
+        try? FileManager.default.createDirectory(at: base, withIntermediateDirectories: true)
+        return base
+    }
+
+    @discardableResult
+    static func addCopy(of source: URL) -> Bear? {
+        let accessed = source.startAccessingSecurityScopedResource()
+        defer {
+            if accessed {
+                source.stopAccessingSecurityScopedResource()
+            }
+        }
+        var index = self.load()
+        let id = UUID().uuidString
+        let ext = source.pathExtension.isEmpty ? "mp4" : source.pathExtension
+        let filename = "\(id).\(ext)"
+        let destination = self.directory().appendingPathComponent(filename)
+        do {
+            if FileManager.default.fileExists(atPath: destination.path) {
+                try FileManager.default.removeItem(at: destination)
+            }
+            try FileManager.default.copyItem(at: source, to: destination)
+        } catch {
+            return nil
+        }
+        let bear = Bear(id: id, name: "Мишка \(index.bears.count + 1)", file: filename)
+        index.bears.append(bear)
+        index.active = id
+        self.save(active: index.active, bears: index.bears)
+        return bear
+    }
+
+    static func delete(id: String) {
+        var index = self.load()
+        if let bear = index.bears.first(where: { $0.id == id }) {
+            try? FileManager.default.removeItem(at: self.directory().appendingPathComponent(bear.file))
+        }
+        index.bears.removeAll { $0.id == id }
+        if index.active == id {
+            index.active = index.bears.last?.id
+        }
+        self.save(active: index.active, bears: index.bears)
+    }
+
+    static func setActive(id: String?) {
+        let index = self.load()
+        self.save(active: id, bears: index.bears)
+    }
+
+    public static func bearForCommand(index: Int) -> Bear? {
+        let loaded = self.load()
+        if index <= 0 {
+            if let active = loaded.active, let bear = loaded.bears.first(where: { $0.id == active }) {
+                return bear
+            }
+            return loaded.bears.first
+        }
+        guard index <= loaded.bears.count else {
+            return nil
+        }
+        return loaded.bears[index - 1]
+    }
+
+    public static func bind(peerId: Int64, timestamp: Int32, file: String) {
+        let key = "giftcam.bearBindings"
+        var map = UserDefaults.standard.dictionary(forKey: key) as? [String: String] ?? [:]
+        map["\(peerId):\(timestamp)"] = file
+        if map.count > 400 {
+            for name in Array(map.keys.prefix(map.count - 300)) {
+                map.removeValue(forKey: name)
+            }
+        }
+        UserDefaults.standard.set(map, forKey: key)
+    }
+
+    public static func boundFileURL(peerId: Int64, timestamp: Int32) -> URL? {
+        let map = UserDefaults.standard.dictionary(forKey: "giftcam.bearBindings") as? [String: String] ?? [:]
+        guard let file = map["\(peerId):\(timestamp)"] else {
+            return nil
+        }
+        let url = self.directory().appendingPathComponent(file)
+        return FileManager.default.fileExists(atPath: url.path) ? url : nil
+    }
+}
+
+final class GiftCamBearsController: UITableViewController, PHPickerViewControllerDelegate {
+    private var active: String?
+    private var bears: [GiftCamBears.Bear] = []
+
+    init() {
+        super.init(style: .insetGrouped)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError()
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.title = "Мои мишки"
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(title: "Закрыть", style: .plain, target: self, action: #selector(self.closePressed))
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(title: "Добавить", style: .done, target: self, action: #selector(self.addPressed))
+        self.reload()
+    }
+
+    private func reload() {
+        let index = GiftCamBears.load()
+        self.active = index.active
+        self.bears = index.bears
+        self.tableView.reloadData()
+    }
+
+    @objc private func closePressed() {
+        self.dismiss(animated: true)
+    }
+
+    @objc private func addPressed() {
+        var configuration = PHPickerConfiguration()
+        configuration.filter = .any(of: [.images, .videos])
+        configuration.selectionLimit = 1
+        let picker = PHPickerViewController(configuration: configuration)
+        picker.delegate = self
+        self.present(picker, animated: true)
+    }
+
+    func picker(_ picker: PHPickerViewController, didFinishPicking results: [PHPickerResult]) {
+        picker.dismiss(animated: true)
+        guard let provider = results.first?.itemProvider else {
+            return
+        }
+        let available = provider.registeredTypeIdentifiers.compactMap { UTType($0) }
+        let gif = available.first { $0.conforms(to: .gif) }
+        let movie = available.first { $0.conforms(to: .movie) }
+        let image = available.first { $0.conforms(to: .image) }
+        guard let type = gif ?? movie ?? image ?? available.first else {
+            return
+        }
+        _ = provider.loadFileRepresentation(for: type) { [weak self] url, _ in
+            guard let url else {
+                return
+            }
+            let saved = GiftCamBears.addCopy(of: url)
+            DispatchQueue.main.async {
+                guard let self else {
+                    return
+                }
+                if saved == nil {
+                    let alert = UIAlertController(title: "Не получилось сохранить файл", message: nil, preferredStyle: .alert)
+                    alert.addAction(UIAlertAction(title: "Ок", style: .default))
+                    self.present(alert, animated: true)
+                }
+                self.reload()
+            }
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        return max(self.bears.count, 1)
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = tableView.dequeueReusableCell(withIdentifier: "bear") ?? UITableViewCell(style: .subtitle, reuseIdentifier: "bear")
+        if self.bears.isEmpty {
+            cell.textLabel?.text = "Нет своих мишек"
+            cell.detailTextLabel?.text = "Добавь видео, гифку или картинку. В чат: #my_1"
+            cell.accessoryType = .none
+            cell.selectionStyle = .none
+            return cell
+        }
+        let bear = self.bears[indexPath.row]
+        let tag = "#my_\(indexPath.row + 1)"
+        cell.textLabel?.text = bear.name
+        cell.detailTextLabel?.text = bear.id == self.active ? "\(tag) · сейчас на подарке" : tag
+        cell.accessoryType = bear.id == self.active ? .checkmark : .none
+        cell.selectionStyle = .default
+        return cell
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard indexPath.row < self.bears.count else {
+            return
+        }
+        let bear = self.bears[indexPath.row]
+        GiftCamBears.setActive(id: bear.id == self.active ? nil : bear.id)
+        self.reload()
+    }
+
+    override func tableView(_ tableView: UITableView, canEditRowAt indexPath: IndexPath) -> Bool {
+        return !self.bears.isEmpty
+    }
+
+    override func tableView(_ tableView: UITableView, commit editingStyle: UITableViewCell.EditingStyle, forRowAt indexPath: IndexPath) {
+        guard editingStyle == .delete, indexPath.row < self.bears.count else {
+            return
+        }
+        GiftCamBears.delete(id: self.bears[indexPath.row].id)
+        self.reload()
+    }
+}
