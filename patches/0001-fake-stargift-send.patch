+            let _ = (context.engine.payments.getUniqueStarGift(slug: slug)
+            |> map { uniqueGift -> StarGift.UniqueGift? in
+                return uniqueGift
+            }
+            |> `catch` { (_: GetUniqueStarGiftError) -> Signal<StarGift.UniqueGift?, NoError> in
+                return .single(nil)
+            }
+            |> take(1)
+            |> deliverOnMainQueue).start(next: { uniqueGift in
+                completion(uniqueGift.map { .unique($0) })
+            })
+            return
+        }
+        guard let index = Int(query), let generic = Self.genericGift(gifts, index: index) else {
+            completion(nil)
+            return
+        }
+        if !unique {
+            completion(.generic(generic))
+            return
+        }
+        let _ = (context.engine.payments.starGiftUpgradePreview(giftId: generic.id)
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { preview in
+            completion(Self.makeUnique(generic, index: index, attributes: preview?.attributes ?? []))
+        })
+    }
