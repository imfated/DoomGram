+
+func giftCamHidesTyping(_ peerId: EnginePeer.Id) -> Bool {
+    let hidden = UserDefaults.standard.stringArray(forKey: "giftcam.hideTyping") ?? []
+    return hidden.contains("\(peerId.toInt64())")
+}
+
+func giftCamFilteredActivities(_ activities: ChatTitleComponent.Activities?) -> ChatTitleComponent.Activities? {
+    guard let activities else {
+        return nil
+    }
+    let chatHidden = giftCamHidesTyping(activities.peerId)
+    let items = activities.items.filter { item in
+        if case .typingText = item.activity {
+            if chatHidden || giftCamHidesTyping(item.peer.id) {
+                return false
+            }
+        }
+        return true
+    }
+    if items.count == activities.items.count {
+        return activities
+    }
+    return ChatTitleComponent.Activities(peerId: activities.peerId, items: items)
+}
