+        }
+        let number = Int32(index)
+        let total = max(gift.availability?.total ?? 1000, number)
+        let unique = StarGift.UniqueGift(
+            id: gift.id,
+            giftId: gift.id,
+            title: gift.title ?? "Gift",
+            number: number,
+            slug: "giftcam-\(gift.id)-\(number)",
+            owner: nil,
+            attributes: result,
+            availability: StarGift.UniqueGift.Availability(issued: number, total: total),
+            giftAddress: nil,
