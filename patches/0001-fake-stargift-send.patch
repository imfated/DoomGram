+        let peerId = message.id.peerId
+        let authorId = incoming ? (message.author?.id ?? peerId) : context.account.peerId
+        self.deliverBear(context: context, peerId: peerId, authorId: authorId, incoming: incoming, text: custom.caption, entities: custom.captionEntities, bearFile: bear.file, key: key)
+        return true
+    }
+
+    private static func deliverBear(context: AccountContext, peerId: PeerId, authorId: PeerId, incoming: Bool, text: String?, entities: [MessageTextEntity], bearFile: String, key: String) {
+        let keepUpdated = context.engine.payments.keepStarGiftsUpdated().start()
+        let _ = (context.engine.payments.cachedStarGifts()
+        |> filter { $0 != nil }
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { starGifts in
+            keepUpdated.dispose()
+            guard let starGifts, let generic = Self.genericGift(starGifts, index: 2) else {
+                self.hiddenCommands.remove(key)
+                self.startedCommands.remove(key)
+                return
+            }
+            self.deliver(account: context.account, peerId: peerId, authorId: authorId, incoming: incoming, gift: .generic(generic), text: text, entities: entities, hideName: false, bearFile: bearFile)
+        })
+    }
+
+    public static func consumeCommandMessage(context: AccountContext, message: Message) {
+        guard self.visualEnabled, message.id.namespace != Namespaces.Message.Local else {
+            return
+        }
+        let key = self.commandKey(message)
+        if self.startedCommands.contains(key) {
+            return
+        }
+        var sourceEntities: [MessageTextEntity] = []
+        for attribute in message.attributes {
+            if let attribute = attribute as? TextEntitiesMessageAttribute {
+                sourceEntities = attribute.entities
+            }
+        }
+        if self.absorbCustom(context: context, message: message, entities: sourceEntities, key: key) {
+            return
+        }
+        guard let command = Self.parseCommand(text: message.text, entities: sourceEntities) else {
+            return
+        }
+        let incoming = message.flags.contains(.Incoming)
+        if !incoming, message.author?.id != context.account.peerId {
+            return
+        }
+        self.startedCommands.insert(key)
+        self.hiddenCommands.insert(key)
+        let peerId = message.id.peerId
+        let authorId = incoming ? (message.author?.id ?? peerId) : context.account.peerId
+        let keepUpdated = context.engine.payments.keepStarGiftsUpdated().start()
+        let _ = (context.engine.payments.cachedStarGifts()
+        |> filter { $0 != nil }
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { starGifts in
+            keepUpdated.dispose()
+            guard let starGifts else {
+                self.hiddenCommands.remove(key)
+                return
+            }
+            Self.resolve(context: context, gifts: starGifts, unique: command.unique, query: command.query, completion: { chosen in
+                guard let chosen else {
+                    self.hiddenCommands.remove(key)
+                    return
+                }
+                self.deliver(account: context.account, peerId: peerId, authorId: authorId, incoming: incoming, gift: chosen, text: command.caption, entities: command.captionEntities, hideName: false)
+            })
+        })
+    }
+}
