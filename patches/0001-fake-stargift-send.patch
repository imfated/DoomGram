+private func giftCamLooseCommand(_ raw: String) -> (unique: Bool, query: String)? {
+    var value = raw.trimmingCharacters(in: .whitespacesAndNewlines)
+    if value.hasPrefix("#") {
+        value = String(value.dropFirst()).trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+    var unique = false
+    if value.lowercased().hasPrefix("nft") {
+        unique = true
+        value = String(value.dropFirst(3)).trimmingCharacters(in: .whitespacesAndNewlines)
+        if value.hasPrefix("_") {
+            value = String(value.dropFirst()).trimmingCharacters(in: .whitespacesAndNewlines)
+        }
+    } else if value.lowercased().hasPrefix("gift") {
+        value = String(value.dropFirst(4)).trimmingCharacters(in: .whitespacesAndNewlines)
+        if value.hasPrefix("_") {
+            value = String(value.dropFirst()).trimmingCharacters(in: .whitespacesAndNewlines)
+        }
+    } else if value.contains("/nft/") {
+        unique = true
+    } else {
+        return nil
+    }
+    if value.isEmpty {
+        return nil
+    }
+    return (unique, value)
+}
+
+private func giftCamCommand(text: String, entities: [MessageTextEntity]) -> (unique: Bool, query: String, caption: String?, captionEntities: [MessageTextEntity])? {
+    let ns = text as NSString
+    let breakRange = ns.rangeOfCharacter(from: CharacterSet.newlines)
+    let firstLine: NSString
+    let captionOffset: Int
+    if breakRange.location != NSNotFound {
+        firstLine = ns.substring(to: breakRange.location) as NSString
+        captionOffset = breakRange.location + breakRange.length
+    } else {
+        firstLine = ns
+        captionOffset = ns.length
+    }
+    let command = firstLine.trimmingCharacters(in: .whitespaces) as String
+    let parsed = giftCamLooseCommand(command)
+    guard let parsed else {
+        return nil
+    }
+    let unique = parsed.unique
+    let query = parsed.query
+    let caption = captionOffset < ns.length ? ns.substring(from: captionOffset) : ""
+    let captionEntities = entities.compactMap { entity -> MessageTextEntity? in
+        guard entity.range.lowerBound >= captionOffset, entity.range.upperBound <= ns.length else {
+            return nil
+        }
+        return MessageTextEntity(range: (entity.range.lowerBound - captionOffset)..<(entity.range.upperBound - captionOffset), type: entity.type)
+    }
+    return (unique, query, caption.isEmpty ? nil : caption, captionEntities)
+}
