+private final class GiftCamBearVideoView: UIView {
+    let url: URL
+    private var player: AVPlayer?
+    private var endObserver: NSObjectProtocol?
+    private let imageView = UIImageView()
+    private var gifFrames: [(UIImage, TimeInterval)] = []
+    private var gifIndex = 0
+    private var gifTimer: Timer?
+
+    init(url: URL) {
+        self.url = url
+        super.init(frame: .zero)
+        self.isUserInteractionEnabled = false
+        self.clipsToBounds = true
+        self.layer.cornerRadius = 16.0
+        self.imageView.contentMode = .scaleAspectFit
+        self.imageView.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        let ext = url.pathExtension.lowercased()
+        if ["mp4", "mov", "m4v", "webm"].contains(ext) {
+            let item = AVPlayerItem(url: url)
+            let player = AVPlayer(playerItem: item)
+            player.isMuted = true
+            self.player = player
+            let playerLayer = AVPlayerLayer(player: player)
+            playerLayer.videoGravity = .resizeAspect
+            playerLayer.frame = self.bounds
+            self.layer.addSublayer(playerLayer)
+            self.endObserver = NotificationCenter.default.addObserver(forName: .AVPlayerItemDidPlayToEndTime, object: item, queue: .main) { [weak player] _ in
+                player?.seek(to: .zero)
+                player?.play()
+            }
+        } else {
+            self.addSubview(self.imageView)
+            if ext == "gif" {
+                self.gifFrames = Self.loadGif(url)
+            }
+            if let first = self.gifFrames.first {
+                self.imageView.image = first.0
+            } else {
+                self.imageView.image = UIImage(contentsOfFile: url.path)
+            }
+        }
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError()
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        self.imageView.frame = self.bounds
+        self.layer.sublayers?.forEach { layer in
+            if let playerLayer = layer as? AVPlayerLayer {
+                playerLayer.frame = self.bounds
+            }
+        }
+    }
+
+    func play() {
+        if let player = self.player {
+            if player.timeControlStatus != .playing {
+                player.play()
+            }
+            return
+        }
+        guard self.gifFrames.count > 1, self.gifTimer == nil else {
+            return
+        }
+        self.scheduleGif()
+    }
+
+    private func scheduleGif() {
+        let delay = self.gifFrames[self.gifIndex].1
+        self.gifTimer = Timer.scheduledTimer(withTimeInterval: max(delay, 0.02), repeats: false) { [weak self] _ in
+            guard let self else {
+                return
+            }
+            self.gifIndex = (self.gifIndex + 1) % self.gifFrames.count
+            self.imageView.image = self.gifFrames[self.gifIndex].0
+            self.gifTimer = nil
+            self.scheduleGif()
+        }
+    }
+
+    private static func loadGif(_ url: URL) -> [(UIImage, TimeInterval)] {
+        guard let source = CGImageSourceCreateWithURL(url as CFURL, nil) else {
+            return []
+        }
+        var frames: [(UIImage, TimeInterval)] = []
+        for index in 0 ..< CGImageSourceGetCount(source) {
+            guard let image = CGImageSourceCreateImageAtIndex(source, index, nil) else {
+                continue
+            }
+            frames.append((UIImage(cgImage: image), Self.gifDelay(source, index)))
+        }
+        return frames
+    }
+
+    private static func gifDelay(_ source: CGImageSource, _ index: Int) -> TimeInterval {
+        guard let properties = CGImageSourceCopyPropertiesAtIndex(source, index, nil) else {
+            return 0.1
+        }
+        let dict = properties as NSDictionary
+        guard let gif = dict.object(forKey: kCGImagePropertyGIFDictionary) as? NSDictionary else {
+            return 0.1
+        }
+        let unclamped = gif.object(forKey: kCGImagePropertyGIFUnclampedDelayTime) as? NSNumber
+        let clamped = gif.object(forKey: kCGImagePropertyGIFDelayTime) as? NSNumber
+        let value = unclamped?.doubleValue ?? clamped?.doubleValue ?? 0.1
+        return value > 0 ? value : 0.1
+    }
+
+    deinit {
+        self.gifTimer?.invalidate()
+        if let endObserver = self.endObserver {
+            NotificationCenter.default.removeObserver(endObserver)
+        }
+    }
+}
+
+private extension ChatMessageGiftBubbleContentNode {
+    func updateGiftCamBearVideo(url: URL?, frame: CGRect) {
+        guard let url else {
+            self.giftCamBearVideoView?.removeFromSuperview()
+            self.giftCamBearVideoView = nil
+            return
+        }
+        let view: GiftCamBearVideoView
+        if let existing = self.giftCamBearVideoView, existing.url == url {
+            view = existing
+        } else {
+            self.giftCamBearVideoView?.removeFromSuperview()
+            view = GiftCamBearVideoView(url: url)
+            self.view.addSubview(view)
+            self.giftCamBearVideoView = view
+        }
+        view.frame = frame
+        self.view.bringSubviewToFront(view)
+        view.play()
+    }
+}
